# Copy to `.env` (gitignored) for local web dev. All web vars must be prefixed
# with VITE_ to be exposed to the client bundle.

# Public API base used by the browser. Keep this relative in local/ngrok dev so
# the app stays same-origin over HTTPS.
VITE_API_URL=/api
# Local FastAPI target that Vite proxies `/api` to during development.
VITE_API_PROXY_TARGET=http://127.0.0.1:8788
VITE_ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase browser auth for the web app.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Firebase web push / PWA configuration
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-firebase-sender-id
VITE_FIREBASE_APP_ID=your-firebase-web-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-firebase-measurement-id
VITE_FIREBASE_VAPID_KEY=your-firebase-web-push-vapid-key

# Dev-only stand-in for the authenticated user, until Clerk sessions are wired
# into the web app. When set, it is sent as the `x-user-id` header so writes
# that record an author (e.g. publishing a notice, approving a visitor) work.
# Must be a real users.id (uuid) from your database.
# VITE_DEV_USER_ID=00000000-0000-0000-0000-000000000000
